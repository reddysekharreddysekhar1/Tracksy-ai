# Server Port
PORT=5000

# Client Application URL (for CORS)
CORS_ORIGIN=http://localhost:3000

# Google Gemini API Key (Required for Receipt OCR, Voice parsing, & Financial Advisor)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Credentials (Optional: if implementing full OAuth redirection flow)
OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
